<?xml version="1.0"?>
<package format="3">
  <name>limo_observation_client</name>
  <version>0.1.0</version>
  <description>LIMO-side ROS 2 node that publishes observations and safely applies central controller velocity commands.</description>

  <maintainer email="maintainer@example.com">mbam</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
