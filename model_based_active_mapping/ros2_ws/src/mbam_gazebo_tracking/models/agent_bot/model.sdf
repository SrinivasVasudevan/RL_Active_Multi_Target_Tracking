<?xml version="1.0"?>
<sdf version="1.6">
  <model name="agent_bot">
    <static>false</static>

    <link name="base_link">
      <pose>0 0 0.15 0 0 0</pose>
      <inertial>
        <mass>6.5</mass>
        <inertia>
          <ixx>0.16</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.18</iyy>
          <iyz>0.0</iyz>
          <izz>0.28</izz>
        </inertia>
      </inertial>

      <collision name="base_collision">
        <geometry>
          <box>
            <size>0.34 0.28 0.14</size>
          </box>
        </geometry>
      </collision>

      <visual name="chassis_lower">
        <geometry>
          <box>
            <size>0.36 0.30 0.08</size>
          </box>
        </geometry>
        <material>
          <ambient>0.06 0.08 0.10 1.0</ambient>
          <diffuse>0.10 0.12 0.16 1.0</diffuse>
          <specular>0.03 0.03 0.03 1.0</specular>
        </material>
      </visual>

      <visual name="chassis_top">
        <pose>0 0 0.06 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.16 0.18 0.22 1.0</ambient>
          <diffuse>0.22 0.24 0.30 1.0</diffuse>
          <specular>0.04 0.04 0.04 1.0</specular>
        </material>
      </visual>

      <visual name="front_bumper">
        <pose>0.19 0 0.01 0 0 0</pose>
        <geometry>
          <box>
            <size>0.06 0.27 0.05</size>
          </box>
        </geometry>
        <material>
          <ambient>0.04 0.04 0.04 1.0</ambient>
          <diffuse>0.08 0.08 0.08 1.0</diffuse>
        </material>
      </visual>

      <visual name="wheel_left">
        <pose>0 0.16 -0.05 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.07</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.03 0.03 0.03 1.0</ambient>
          <diffuse>0.07 0.07 0.07 1.0</diffuse>
        </material>
      </visual>

      <visual name="wheel_right">
        <pose>0 -0.16 -0.05 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.07</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.03 0.03 0.03 1.0</ambient>
          <diffuse>0.07 0.07 0.07 1.0</diffuse>
        </material>
      </visual>

      <visual name="rear_caster">
        <pose>-0.15 0 -0.065 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.03</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.16 0.16 0.16 1.0</ambient>
          <diffuse>0.22 0.22 0.22 1.0</diffuse>
        </material>
      </visual>

      <visual name="lidar_puck">
        <pose>0 0 0.12 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.045</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.18 0.18 0.18 1.0</ambient>
          <diffuse>0.24 0.24 0.24 1.0</diffuse>
        </material>
      </visual>

      <visual name="camera_module">
        <pose>0.15 0 0.10 0 0 0</pose>
        <geometry>
          <box>
            <size>0.06 0.08 0.05</size>
          </box>
        </geometry>
        <material>
          <ambient>0.70 0.72 0.76 1.0</ambient>
          <diffuse>0.78 0.80 0.84 1.0</diffuse>
        </material>
      </visual>

      <sensor name="front_camera" type="camera">
        <pose>0.17 0 0.10 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>15.0</update_rate>
        <visualize>true</visualize>
        <camera>
          <horizontal_fov>1.39626</horizontal_fov>
          <image>
            <width>640</width>
            <height>360</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>35.0</far>
          </clip>
        </camera>
        <plugin name="gazebo_ros_camera" filename="libgazebo_ros_camera.so">
          <ros>
            <remapping>image_raw:=camera/image_raw</remapping>
            <remapping>camera_info:=camera/camera_info</remapping>
          </ros>
          <camera_name>camera</camera_name>
          <frame_name>camera_link</frame_name>
        </plugin>
      </sensor>

      <sensor name="planar_lidar" type="ray">
        <pose>0 0 0.13 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>20.0</update_rate>
        <visualize>false</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.05</min>
            <max>40.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
        <plugin name="gazebo_ros_laser" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <remapping>~/out:=scan</remapping>
          </ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>laser_link</frame_name>
        </plugin>
      </sensor>
    </link>

    <plugin name="planar_move" filename="libgazebo_ros_planar_move.so">
      <ros>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      <command_timeout>0.5</command_timeout>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>false</publish_odom_tf>
    </plugin>
  </model>
</sdf>
