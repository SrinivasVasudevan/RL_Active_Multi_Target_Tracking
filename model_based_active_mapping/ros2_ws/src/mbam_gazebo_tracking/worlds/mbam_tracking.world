<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="mbam_tracking_world">
    <include>
      <uri>model://sun</uri>
    </include>

    <physics type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_update_rate>500</real_time_update_rate>
      <real_time_factor>1</real_time_factor>
    </physics>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.90 0.94 1.0 1</background>
      <shadows>true</shadows>
    </scene>

    <model name="green_ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>250 250</size>
            </plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>250 250</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.10 0.48 0.12 1</ambient>
            <diffuse>0.12 0.56 0.15 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="tree_01">
      <static>true</static>
      <pose>-9.0 -8.5 0 0 0 0</pose>
      <link name="tree_link">
        <visual name="trunk">
          <pose>0 0 1.1 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.22</radius>
              <length>2.2</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.28 0.20 0.12 1</ambient>
            <diffuse>0.36 0.24 0.14 1</diffuse>
          </material>
        </visual>
        <visual name="leaves_low">
          <pose>0 0 2.8 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>1.0</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.12 0.34 0.12 1</ambient>
            <diffuse>0.16 0.46 0.16 1</diffuse>
          </material>
        </visual>
        <visual name="leaves_high">
          <pose>0 0 3.6 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>0.75</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.10 0.30 0.10 1</ambient>
            <diffuse>0.14 0.40 0.14 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="tree_02">
      <static>true</static>
      <pose>8.8 -9.2 0 0 0 0</pose>
      <link name="tree_link">
        <visual name="trunk">
          <pose>0 0 1.0 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.20</radius>
              <length>2.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.30 0.20 0.13 1</ambient>
            <diffuse>0.38 0.25 0.16 1</diffuse>
          </material>
        </visual>
        <visual name="leaves">
          <pose>0 0 3.0 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>1.2</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.14 0.36 0.14 1</ambient>
            <diffuse>0.18 0.50 0.18 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="tree_03">
      <static>true</static>
      <pose>-10.2 8.0 0 0 0 0</pose>
      <link name="tree_link">
        <visual name="trunk">
          <pose>0 0 0.95 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.18</radius>
              <length>1.9</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.28 0.18 0.12 1</ambient>
            <diffuse>0.35 0.23 0.15 1</diffuse>
          </material>
        </visual>
        <visual name="leaves">
          <pose>0 0 2.7 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>1.1</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.10 0.31 0.10 1</ambient>
            <diffuse>0.14 0.44 0.14 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="tree_04">
      <static>true</static>
      <pose>10.0 9.0 0 0 0 0</pose>
      <link name="tree_link">
        <visual name="trunk">
          <pose>0 0 1.0 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.19</radius>
              <length>2.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.29 0.19 0.12 1</ambient>
            <diffuse>0.37 0.24 0.15 1</diffuse>
          </material>
        </visual>
        <visual name="leaves">
          <pose>0 0 3.0 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>1.15</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.12 0.33 0.12 1</ambient>
            <diffuse>0.16 0.47 0.16 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>30.0</update_rate>
    </plugin>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 -25 25 0.8 0 1.57</pose>
      </camera>
    </gui>
  </world>
</sdf>
