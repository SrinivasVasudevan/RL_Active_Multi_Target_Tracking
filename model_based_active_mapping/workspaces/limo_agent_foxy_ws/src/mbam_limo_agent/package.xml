<?xml version="1.0"?>
<package format="3">
  <name>mbam_limo_agent</name>
  <version>0.1.0</version>
  <description>Safety gating and velocity limits for LIMO agents (ROS 2 Foxy).</description>

  <maintainer email="maintainer@example.com">mbam</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>launch_ros</depend>

  <exec_depend>python3-numpy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
